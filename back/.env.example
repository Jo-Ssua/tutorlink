NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
DATABASE_URL=postgresql://tutorlink:tutorlink@localhost:5432/tutorlink?schema=public
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_REFRESH_EXPIRES_IN=7d
EMAIL_CODE_SECRET=change-me-email-code-secret-at-least-32-characters
ANONYMITY_SALT=change-me-anonymity-salt
INSTITUTIONAL_EMAIL_DOMAINS=universidad.edu.co,estudiantes.universidad.edu.co
CORS_ORIGINS=http://localhost:3001,http://localhost:5173
PLATFORM_FEE_PERCENT=10
CANCELLATION_WINDOW_HOURS=24
STUDYMATCH_TTL_CRITICAL_MINUTES=5
STUDYMATCH_TTL_HIGH_MINUTES=10
STUDYMATCH_TTL_MEDIUM_MINUTES=20
STUDYMATCH_TTL_LOW_MINUTES=30
STUDYMATCH_STUDENT_CONFIRM_MINUTES=10
STUDYMATCH_WEIGHT_PROFESSOR=35
STUDYMATCH_WEIGHT_RATING=30
STUDYMATCH_WEIGHT_AVAILABILITY=25
STUDYMATCH_WEIGHT_WORKLOAD=10
EXPOSE_DEV_CODES=true
SEED_ON_START=false

# Docker Compose
DOCKER_SEED_ON_START=true
