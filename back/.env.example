NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
# URL publica del frontend: base de los enlaces que viajan por correo
APP_URL=http://localhost:5173
DATABASE_URL=postgresql://tutorlink:tutorlink@localhost:5432/tutorlink?schema=public
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_REFRESH_EXPIRES_IN=7d
EMAIL_CODE_SECRET=change-me-email-code-secret-at-least-32-characters
ANONYMITY_SALT=change-me-anonymity-salt
INSTITUTIONAL_EMAIL_DOMAINS=universidad.edu.co,estudiantes.universidad.edu.co
# Opcional. Limita los programas que puede elegir cada dominio, por codigo de facultad.
# Formato: dominio:FAC1|FAC2;otro.dominio:FAC3   (vacio = cualquier programa del catalogo)
INSTITUTIONAL_DOMAIN_FACULTIES=
CORS_ORIGINS=http://localhost:3001,http://localhost:5173
PLATFORM_FEE_PERCENT=10
CANCELLATION_WINDOW_HOURS=24
STUDYMATCH_TTL_CRITICAL_MINUTES=5
STUDYMATCH_TTL_HIGH_MINUTES=10
STUDYMATCH_TTL_MEDIUM_MINUTES=20
STUDYMATCH_TTL_LOW_MINUTES=30
STUDYMATCH_STUDENT_CONFIRM_MINUTES=10
STUDYMATCH_WEIGHT_PROFESSOR=35
STUDYMATCH_WEIGHT_RATING=30
STUDYMATCH_WEIGHT_AVAILABILITY=25
STUDYMATCH_WEIGHT_WORKLOAD=10
# Correo
# console: no envia nada, escribe el correo en el log (desarrollo y CI)
# smtp:    envia de verdad y exige SMTP_HOST y MAIL_FROM
MAIL_TRANSPORT=console
MAIL_FROM=TutorLink <no-reply@tutorlink.local>
MAIL_VERIFICATION_PATH=/verificar
MAIL_LOGIN_PATH=/login
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Devuelve el codigo de verificacion en la respuesta de /auth/register.
# Solo para desarrollo: la API rechaza true si NODE_ENV=production.
EXPOSE_DEV_CODES=false
SEED_ON_START=false

# Docker Compose
DOCKER_SEED_ON_START=true
